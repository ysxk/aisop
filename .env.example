# Copy to .env, replace placeholders, and keep .env out of version control.
# The binary and Makefile do not load this file automatically.
# Compose interpolates this file; its DATABASE_URL is built from POSTGRES_PASSWORD.
# Use the SAME URL-safe password in both placeholders below (A-Z a-z 0-9 _ -).
POSTGRES_PASSWORD=replace_with_a_random_url_safe_password
DATABASE_URL=postgres://aisop:replace_with_a_random_url_safe_password@127.0.0.1:5432/aisop?sslmode=disable

# Native process settings; Compose overrides ADDR and MEDIA_DIR inside containers.
ADDR=127.0.0.1:8080
MEDIA_DIR=./data/media
SESSION_TTL=24h
IMAGE_MAX_BYTES=10485760
VIDEO_MAX_BYTES=209715200
ALLOWED_ORIGINS=

# Compose host-side binding; do not expose directly to the Internet.
APP_BIND=127.0.0.1
APP_PORT=8080

# ADMIN_USERNAME and ADMIN_PASSWORD are intentionally omitted.
# Read them interactively and export only for bootstrap-admin or login.
# TEST_DATABASE_URL is opt-in; point it at a dedicated test database.
